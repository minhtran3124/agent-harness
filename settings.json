{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/pre-bash-dispatch.sh",
            "statusMessage": "Git commit/push gates (untracked-py, quality, risk, branch)…"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/branch-isolation-guard.sh",
            "statusMessage": "Branch-isolation guard (block code edits on a shared branch)…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/ruff-on-edit.sh",
            "statusMessage": "ruff --fix on edited .py…"
          },
          {
            "type": "command",
            "command": "hooks/blast-radius-check.sh",
            "statusMessage": "Blast-radius check (edit vs active plan)…"
          },
          {
            "type": "command",
            "command": "hooks/render-plan-on-write.sh",
            "statusMessage": "Auto-render PLAN.html…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/scope-gate.sh",
            "statusMessage": "Scope-gate check…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/session-knowledge.sh",
            "statusMessage": "Loading knowledge base (INDEX + critical-patterns)…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/state-breadcrumb.sh",
            "statusMessage": "Writing session breadcrumb to specs/STATE.md…"
          }
        ]
      }
    ]
  }
}
