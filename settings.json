      "Bash(git push * \"+main\"*)",
      "Bash(git push * 'main'*)",
      "Bash(git push * '*:main'*)",
      "Bash(git push * '+main'*)",
      "Bash(git push *refs/heads/master*)",
      "Bash(git push * master *)",
      "Bash(git push *:master *)",
      "Bash(git push * +master *)",
      "Bash(git push * \"master\"*)",
      "Bash(git push * \"*:master\"*)",
      "Bash(git push * \"+master\"*)",
      "Bash(git push * 'master'*)",
      "Bash(git push * '*:master'*)",
      "Bash(git push * '+master'*)"
    ]
  }
