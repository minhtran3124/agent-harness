  "claims": [
    {
      "id": "claim_21d3484edd904b45878041583c735de7",
      "statement": "apply_model_config.py writes only <claude-dir>/agents/<role>.md and <claude-dir>/skills/<name>/SKILL.md for roles and skills named in the defaults snapshot, and never writes settings.json or settings.local.json, so the main session's model/effort and mid-session /model and /effort choices are never overridden.",
      "evidence": [
        {
          "resource": "repo://scripts/apply_model_config.py#L1-L6",
          "version": "repo-lines-v1:sha256:dff898f14e410d75b7a5a804704e7e1d74e19c6393eef516d236dfff3984a45d:"
        },
        {
