    {
      "id": "claim_3a4978c1a6d1411eac315afd9a6cd67f",
      "statement": "post-merge-maintenance runs on pull_request_target closed events filtered to the base-branch allowlist [main, loop, simplify], and its job runs only for merged PRs whose head ref does not start with chore/bookkeeping- (loop guard).",
      "evidence": [
        {
          "resource": "repo://.github/workflows/post-merge-maintenance.yml#L11-L46",
          "version": "repo-lines-v1:sha256:84e486a77d4130c38203fb302172d6c128919773b960b0a46bc4d040c1019ce7:"
        }
      ]
    },
    {
      "id": "claim_82a1ba868af146849e63bc7c1ebfbcca",
      "statement": "Because pull_request_target loads the workflow definition and its branches allowlist from the default branch (main), edits to the allowlist on an integration branch have no effect until synced to main; a PR merged into an unlisted branch fires nothing silently.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/post-merge-maintenance.yml#L14-L34",
          "version": "repo-lines-v1:sha256:75b020815ccb1e619addbee5ba65364228d6336e1ce9a3c7dce18bce55b99c24:"
        }
      ]
