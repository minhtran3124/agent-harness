    {
      "id": "claim_6f63de42890947e99e158a5d06f15ba4",
      "statement": "The repository is organized as two layers: an engine of skills and agents (skills/, agents/) that does the work, and a harness (feature-intake, hooks/, rules/, specs/<slug>/SUMMARY.md) that decides before the engine runs how much process a change needs and when to involve a human.",
      "evidence": [
        {
          "resource": "repo://HARNESS.md#L9-L17",
          "version": "repo-lines-v1:sha256:492865f78a321265d9a90931cbf1175d91145e1abff14bab9e7ebc34faa913c7:"
        }
      ]
    },
    {
      "id": "claim_fbaf4ce0f8d341eabbcb892bb3bfafa3",
      "statement": "The harness principle is that ceremony scales with risk (lane) while human interruption scales with ambiguity/confidence; these are independent dials.",
