  "claims": [
    {
      "id": "claim_5de69cccac5a4dbaa04b36e39505f66d",
      "statement": "The repository has two layers: an engine of invocable skills/agents that do the work, and a thin risk/trust harness (feature-intake, hooks, rules, specs/<slug>/SUMMARY.md) that decides how much process a change needs and when to involve a human, governed by the principle that ceremony scales with risk and human interruption scales with ambiguity.",
      "evidence": [
        {
          "resource": "repo://HARNESS.md#L9-L40",
          "version": "repo-lines-v1:sha256:664e82b03ad135a9162d0373ff17132ca48b32fa9f93c4f9b1469edb18714afc:"
        }
      ]
    },
    {
      "id": "claim_2d3bb7e5df9e46d9881d02d7ff6f5502",
      "statement": "/feature-intake runs first, classifies the request with a 10-flag risk checklist plus hard gates, and writes a Lane (tiny|normal|high-risk) and Confidence to specs/<slug>/SUMMARY.md; at commit time hooks corroborate the declared lane against the staged diff, with workflow-engine and weakening-validation in warn mode.",
      "evidence": [
