    {
      "id": "claim_cf79fb8b3b8944498a3703160f571e0f",
      "statement": "docs/solutions/README.md defines records as <category>/<slug>.md files with front-matter fields problem_type (bug|knowledge|decision|failure), module, tags, severity (critical|standard), applicable_when, affects, optional supersedes, confidence, and confirmed_at, and maps each problem_type to required body sections, with failure requiring Symptom, Wrong_Approach, Why_It_Failed, Correct_Approach, and Guardrail.",
      "evidence": [
        {
          "resource": "repo://docs/solutions/README.md#L10-L56",
          "version": "repo-lines-v1:sha256:f23db4fb3b0e6195617f379d9e3190f4b0e6e2ccb066a64382fb6cba5d542366:"
        }
      ]
    },
    {
      "id": "claim_24ac78f21c1b4f998acd2fffa24914d0",
      "statement": "The knowledge base's confidence-decay rule ties confidence to confirmed_at age (high <30 days, medium >1 month, low >3 months treated as hypothesis), and re-verification updates confirmed_at to today and bumps confidence; CLAUDE.md tells agents to treat entries older than 30 days as potentially stale.",
