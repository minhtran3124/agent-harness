      "evidence": [
        {
          "resource": "repo://skills/diagnosing-bugs/SKILL.md",
          "version": "repo-file-v1:sha256:0b16a22e954aa323f327d8286509d21189eff5fcb47d3fb51ddfc39a129633a9"
        }
