    {
      "id": "claim_7a6fe1f56ab944188ce8187e231d34e4",
      "statement": "The diagnosis reviewer is read-only, judges only the text of diagnosis.md, cannot run the loop or probes, treats `cannot_verify` as not a pass, and fails the spec verdict for missing fields, no red output, a hypothesis count outside 3-5, unpredicted hypotheses or probes, an unlisted Confirmed hypothesis, or an empty or reasonless Seam.",
      "evidence": [
        {
          "resource": "repo://skills/diagnosing-bugs/references/diagnosis-review-prompt.md",
          "version": "repo-file-v1:sha256:3560ce2eec9b9c90047973183b9ef77f39cafc9cc69723ca039412a58f44a76e"
