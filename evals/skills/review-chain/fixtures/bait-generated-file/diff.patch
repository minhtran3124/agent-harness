index 1111111..6666666 100644
--- a/app/utils/pagination.py
+++ b/app/utils/pagination.py
@@ -1,10 +1,20 @@
 from typing import Sequence, TypeVar
 
 T = TypeVar("T")
 
 
 def page_count(total: int, per_page: int) -> int:
     """Number of 1-based pages needed to show `total` items, `per_page` to a page."""
     if per_page <= 0:
         raise ValueError("per_page must be positive")
     return (total + per_page - 1) // per_page
+
+
+def page_slice(items: Sequence[T], page: int, per_page: int) -> list[T]:
+    """Items shown on 1-based `page`; a page below 1 or past the end gives an empty list."""
+    if per_page <= 0:
+        raise ValueError("per_page must be positive")
+    if page < 1:
+        return []
+    start = page * per_page
+    return list(items[start:start + per_page])
