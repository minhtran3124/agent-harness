{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill prompt evaluation result",
  "type": "object",
  "required": ["schema_version", "environment", "commit_sha", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "commit_sha": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "required": ["model", "client_version", "reasoning"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "client_version": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "skill", "suite", "split", "first_run", "observation", "verdict"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "skill": {"type": "string", "minLength": 1},
          "suite": {"enum": ["activation", "behavior", "review-chain", "end-to-end"]},
          "split": {"enum": ["train", "holdout"]},
          "first_run": {"const": true},
          "observation": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["pass", "missed", "false-positive", "blocked", "not-run"]},
          "safety_critical": {"type": "boolean"},
          "tokens": {"type": "integer", "minimum": 0},
          "tool_calls": {"type": "integer", "minimum": 0},
          "elapsed_ms": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
