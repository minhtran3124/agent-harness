{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.toml$", "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "hooks": {
      "items": {"pattern": "^hooks/[a-z0-9./-]+$", "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "packaging_decision": {"const": "hybrid"},
    "runtime": {"const": "codex"},
    "schema_version": {"const": 1},
    "skills": {
      "items": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": ["schema_version", "runtime", "packaging_decision", "skills", "hooks", "agents"],
  "title": "Rendered Codex adapter inventory",
  "type": "object"
}
