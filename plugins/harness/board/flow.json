    { "id": "test",    "t": "Test suite",       "a": "full suite once",        "x": 840,  "y": 250, "match": ["^test$"] },
    { "id": "adr",     "t": "Decisions",        "a": "ADRs, specs, artifact",  "x": 1040, "y": 250, "match": ["^write ADRs$", "^write specs/ flow files$", "^update run artifact$"] },
